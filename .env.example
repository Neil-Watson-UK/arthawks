# Public (safe to expose to the browser)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo / mocks — leave unset or false in pilot/production
PUBLIC_DEMO_IDENTITIES=false
PUBLIC_ALLOW_MOCK_FALLBACKS=false

# Server-only Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: apply migrations via scripts/apply-migrations.mjs
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Stripe (test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PURCHASE_CODE_PEPPER=long-random-string-for-pickup-code-hashing

# Admin bootstrap (scripts/seed-admin.mjs only — never commit real values)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Art Hawks Admin

# Node adapter (IONOS / production)
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
ORIGIN=https://YOUR_DOMAIN

# Outbound email (IONOS Basic SMTP) — server-only
# Authenticate as one mailbox (recommend support@). Role inboxes via Reply-To.
MAIL_SMTP_HOST=smtp.ionos.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=support@arthawks.com
MAIL_SMTP_PASS=
MAIL_FROM="Art Hawks <support@arthawks.com>"
MAIL_REPLY_HELLO=hello@arthawks.com
MAIL_REPLY_ARTISTS=artists@arthawks.com
MAIL_REPLY_VENUES=venues@arthawks.com
MAIL_REPLY_SUPPORT=support@arthawks.com
MAIL_BCC_FOUNDER=neil@arthawks.com

# Google reCAPTCHA v3 (contact forms) — create keys at https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
